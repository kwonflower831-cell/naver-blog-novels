{
  "name": "소설 연재 작업실 (naver-blog-novels)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "LANG": "C.UTF-8",
    "PYTHONIOENCODING": "utf-8"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "files.encoding": "utf8",
        "editor.wordWrap": "on"
      }
    }
  }
}
